#!/usr/bin/env bash
set -euo pipefail

node <<'NODE'
// Use localhost (not 127.0.0.1): `vinext dev` binds to the IPv6 loopback
// ([::1]:PORT) only and does not honor --host, so an IPv4 127.0.0.1 URL is
// refused even while the preview is healthy. localhost resolves to whatever
// the server actually bound to, so Node's fetch reaches it.
const url = process.env.FIGMA_MAKE_URL ?? `http://localhost:${process.env.PORT ?? 3000}`
// First request triggers the vinext/Cloudflare Workers build, which can take
// longer than a stock 30s on a cold start; give it room so setup is reliable.
const deadline = Date.now() + 90_000

while (Date.now() < deadline) {
  try {
    const response = await fetch(url)
    const html = await response.text()
    if (response.ok && html.includes('Make Local Lobby')) {
      console.log(`Make Local Lobby preview ready: ${url}`)
      process.exit(0)
    }
  } catch {}
  await new Promise((resolve) => setTimeout(resolve, 500))
}

console.error(`Make Local Lobby preview did not become ready: ${url}`)
process.exit(1)
NODE
