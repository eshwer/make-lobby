#!/usr/bin/env bash
set -euo pipefail

node -e 'const [major, minor] = process.versions.node.split(".").map(Number); if (major < 22 || (major === 22 && minor < 13)) { console.error("Make on your codebase requires Node.js 22.13 or newer."); process.exit(1) }'
echo "Make on your codebase system check passed"
